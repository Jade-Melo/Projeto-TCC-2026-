<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_aplicativo"
    android:orientation="vertical"
    tools:context="Activites.LoginActivity">

    <ImageView
        android:layout_width="180dp"
        android:layout_height="230dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        android:contentDescription="Logo Balance Tech" />

    <TextView
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:fontFamily="@font/inter_18pt_regular"
        android:textStyle="bold"
        android:textSize="32sp"
        android:textColor="@color/texto_titulo"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Informe seus dados para acessar sua conta."
        android:fontFamily="@font/inter_18pt_regular"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/texto_titulo"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <!-- EMAIL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:fontFamily="@font/inter_18pt_regular"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/texto_titulo"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/edtEmailLogin"
        android:layout_width="match_parent"
        app:cornerRadius="8dp"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="20dp"
        android:hint="Digite seu email"
        android:textColor="@color/texto_titulo"
        android:textColorHint="@color/texto_subtitulo_e_termos"
        android:padding="10dp"
        android:background="@drawable/edittext_background"
        android:inputType="textEmailAddress" />

    <!-- SENHA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Senha"
        android:fontFamily="@font/inter_18pt_regular"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/texto_titulo"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/edtSenhaLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="20dp"
        android:hint="Digite sua senha"
        android:textColor="@color/texto_titulo"
        android:textColorHint="@color/texto_subtitulo_e_termos"
        android:padding="10dp"
        android:background="@drawable/edittext_background"
        android:inputType="textPassword" />

    <!-- ESQUECEU A SENHA -->
    <TextView
        android:id="@+id/esqueciSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esqueceu a senha?"
        android:fontFamily="@font/inter_18pt_regular"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/texto_titulo"
        android:layout_marginStart="25dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- BOTÃO ENTRAR -->
    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrar"
        android:textSize="18sp"
        app:cornerRadius="8dp"
        android:fontFamily="@font/inter_18pt_medium"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/fundo_botao_principal"
        android:textColor="@color/texto_botao_principal" />

    <TextView
        android:id="@+id/txtCadastro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Não tem uma conta? Cadastre-se aqui"
        android:fontFamily="@font/inter_18pt_regular"
        android:textSize="15sp"
        android:textColor="@color/texto_titulo"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_aplicativo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- BOTÃO VOLTAR -->
        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/texto_titulo"
            android:textSize="45sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- LOGO -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="230dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            android:contentDescription="Logo Balance Tech" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="30dp"
            android:gravity="center"
            android:text="Nova senha"
            android:fontFamily="@font/inter_18pt_regular"
            android:textColor="@color/texto_titulo"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- DESCRIÇÃO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="35dp"
            android:gravity="center"
            android:text="Crie uma nova senha para acessar sua conta."
            android:fontFamily="@font/inter_18pt_regular"
            android:textColor="@color/texto_titulo"
            android:textSize="15sp" />

        <!-- NOVA SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="5dp"
            android:text="Nova senha"
            android:fontFamily="@font/inter_18pt_regular"
            android:textColor="@color/texto_titulo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNovaSenha"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/edittext_background"
            android:fontFamily="@font/inter_18pt_regular"
            android:hint="Digite sua nova senha"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/texto_titulo"
            android:textColorHint="@color/texto_titulo"
            android:textSize="16sp" />

        <!-- CONFIRMAR SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="5dp"
            android:text="Confirmar senha"
            android:fontFamily="@font/inter_18pt_regular"
            android:textColor="@color/texto_titulo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/edittext_background"
            android:fontFamily="@font/inter_18pt_regular"
            android:hint="Digite novamente sua senha"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/texto_titulo"
            android:textColorHint="@color/texto_subtitulo_e_termos"
            android:textSize="16sp" />

        <!-- BOTÃO ALTERAR SENHA -->
        <Button
            android:id="@+id/btnAlterarSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="35dp"
            android:layout_marginEnd="30dp"
            android:backgroundTint="@color/fundo_botao_principal"
            android:fontFamily="@font/inter_18pt_medium"
            android:text="Alterar senha"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao_principal"
            android:textSize="18sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>
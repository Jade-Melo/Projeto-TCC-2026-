<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ========================= -->
    <!-- CABEÇALHO -->
    <!-- ========================= -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- MENU -->

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Abrir menu"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu"
            android:clickable="true"
            android:focusable="true" />


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Como se conectar?"
            android:textColor="#222222"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- PERFIL -->

        <ImageButton
            android:id="@+id/btnPerfilConexao"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Abrir perfil"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_perfil_home"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>


    <!-- LINHA -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />


    <!-- ========================= -->
    <!-- INSTRUÇÕES -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="1º Ligue o dispositivo Bluetooth e coloque-o em modo de pareamento."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="2º Ative o Bluetooth do celular nas configurações."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="3º Procure o dispositivo na lista de aparelhos disponíveis."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="4º Selecione o dispositivo e confirme o pareamento, se necessário."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="5º Abra o aplicativo e acesse a tela de conexão."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="6º Toque em “Conectar Dispositivo”."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="7º Escolha o dispositivo Bluetooth pareado na lista exibida pelo aplicativo."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="8º Aguarde a confirmação de conexão."
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTÃO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/areaBotao"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar"
            android:textSize="18sp"
            app:cornerRadius="8dp"
            android:fontFamily="@font/inter_18pt_medium"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/fundo_botao_principal"
            android:textColor="@color/texto_botao_principal" />

        />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp">

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="Menu"
                android:padding="6dp"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Evolução"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPerfilEvolucao"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="Perfil"
                android:padding="6dp"
                android:src="@drawable/ic_perfil_home" />

        </RelativeLayout>


        <!-- ========================= -->
        <!-- CALORIAS -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Calorias"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCalorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="2.885 / 3.000 Kcal"
            android:textColor="#777777"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressCalorias"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="96"
            android:progressDrawable="@drawable/progress_green" />


        <!-- ========================= -->
        <!-- NUTRIENTES -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nutrientes"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ========================= -->
        <!-- BOTÕES -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/btnCarbs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:text="Carbs"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/menu_item_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnGorduras"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:text="Gordura"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/menu_item_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnProteinas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="Proteína"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/menu_item_background"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- META / ATUAL -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meta: "
                android:textColor="#777777"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="349 g"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="Atual: "
                android:textColor="#777777"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtAtual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="211 g"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- GRÁFICO -->
        <!-- ========================= -->

    <com.example.balancetech_tcc_equipe05.activites.GraficoEvolucaoView
        android:id="@+id/graficoEvolucao"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="15dp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <!-- ========================= -->
    <!-- CABEÇALHO -->
    <!-- ========================= -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">

        <!-- MENU -->

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Abrir menu"
            android:clickable="true"
            android:focusable="true" />

        <!-- TÍTULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Monte seu prato"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- PERFIL -->

        <ImageButton
            android:id="@+id/btnPerfilMontePrato"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:src="@drawable/ic_perfil_grande"
            android:contentDescription="Perfil"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>


    <!-- ========================= -->
    <!-- PESQUISA -->
    <!-- ========================= -->

    <EditText
        android:id="@+id/edtPesquisa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/search_background"
        android:hint="Buscar alimento"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="#111111"
        android:textColorHint="#444444"
        android:textSize="17sp"
        android:inputType="text" />


    <TextView
        android:id="@+id/txtPratoAtual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="#23652B"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtSemAlimentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum alimento encontrado"
        android:textColor="#444444"
        android:visibility="gone" />


    <!-- ========================= -->
    <!-- LISTA -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/listaAlimentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTÕES INFERIORES -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTare"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:background="@drawable/button_tare"
            android:gravity="center"
            android:text="Tare balança"
            android:textColor="#000000"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnPronto"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:background="@drawable/button_pronto"
            android:gravity="center"
            android:backgroundTint="@color/fundo_botao_principal"
            android:text="Pronto"
            android:textColor="#23652B"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

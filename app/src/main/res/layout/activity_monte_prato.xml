<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <!-- ========================= -->
    <!-- CABEÇALHO -->
    <!-- ========================= -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <!-- MENU -->

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Abrir menu"
            android:clickable="true"
            android:focusable="true" />

        <!-- TÍTULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Monte seu prato"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- PERFIL -->

        <ImageButton
            android:id="@+id/btnPerfilMontePrato"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:src="@drawable/ic_perfil_grande"
            android:contentDescription="Perfil"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>


    <!-- ========================= -->
    <!-- PESQUISA -->
    <!-- ========================= -->

    <EditText
        android:id="@+id/edtPesquisa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/search_background"
        android:hint="⌕ O que você está pesando agora?"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="#111111"
        android:textColorHint="#444444"
        android:textSize="17sp"
        android:inputType="text" />


    <!-- ESPAÇO -->

    <Space
        android:layout_width="match_parent"
        android:layout_height="35dp" />


    <!-- ========================= -->
    <!-- LISTA -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ARROZ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Arroz branco"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnArroz"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- FEIJÃO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Feijão cozido"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnFeijao"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- FRANGO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Peito de frango"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnFrango"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- OVO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Ovo frito"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnOvo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- MANGA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Manga"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnManga"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- BRÓCOLIS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Brócolis"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnBrocolis"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- MANDIOCA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Mandioca"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnMandioca"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />


            <!-- BATATA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Batata cozida"
                    android:textColor="#111111"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnBatata"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/plus_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#588C53"
                    android:textSize="31sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#999999" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTÕES INFERIORES -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTare"
            android:layout_width="145dp"
            android:layout_height="45dp"
            android:background="@drawable/button_tare"
            android:gravity="center"
            android:text="Tare balança"
            android:textColor="#000000"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <Space
            android:layout_width="40dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnPronto"
            android:layout_width="145dp"
            android:layout_height="45dp"
            android:background="@drawable/button_pronto"
            android:gravity="center"
            android:backgroundTint="@color/fundo_botao_principal"
            android:text="Pronto"
            android:textColor="#23652B"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
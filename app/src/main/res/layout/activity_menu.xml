<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- FUNDO ESCURECIDO -->
    <View
        android:id="@+id/menuFora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:clickable="true"
        android:focusable="true" />

    <!-- PAINEL DO MENU -->
    <ScrollView
        android:id="@+id/painelMenu"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_menu_painel"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="8dp">

                <ImageView
                    android:id="@+id/imgUsuario"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:src="@drawable/ic_perfil_grande"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto do usuário" />

                <TextView
                    android:id="@+id/txtNomeUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Nome Usuario"
                    android:textColor="#333333"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E5E5" />

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/menuHome"
                style="@style/MenuItem"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Home" />

                <TextView
                    style="@style/MenuText"
                    android:text="Home" />

            </LinearLayout>

            <!-- BALANÇA -->
            <LinearLayout
                android:id="@+id/menuBalanca"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_balanca"
                    android:contentDescription="Conecte a balança" />

                <TextView
                    style="@style/MenuText"
                    android:text="Conecte a balança" />

            </LinearLayout>

            <!-- MONTE SEU PRATO -->
            <LinearLayout
                android:id="@+id/menuMontePrato"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_monte_prato"
                    android:contentDescription="Monte seu prato" />

                <TextView
                    style="@style/MenuText"
                    android:text="Monte seu prato" />

            </LinearLayout>

            <!-- REFEIÇÕES -->
            <LinearLayout
                android:id="@+id/menuRefeicoes"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_refeicoes"
                    android:contentDescription="Refeições" />

                <TextView
                    style="@style/MenuText"
                    android:text="Refeições" />

            </LinearLayout>

            <!-- HISTÓRICO -->
            <LinearLayout
                android:id="@+id/menuHistorico"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_historico"
                    android:contentDescription="Histórico" />

                <TextView
                    style="@style/MenuText"
                    android:text="Histórico" />

            </LinearLayout>

            <!-- EVOLUÇÃO -->
            <LinearLayout
                android:id="@+id/menuEvolucao"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_evolucao"
                    android:contentDescription="Evolução" />

                <TextView
                    style="@style/MenuText"
                    android:text="Evolução" />

            </LinearLayout>

            <!-- PERFIL -->
            <LinearLayout
                android:id="@+id/menuPerfil"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_perfil"
                    android:contentDescription="Perfil" />

                <TextView
                    style="@style/MenuText"
                    android:text="Perfil" />

            </LinearLayout>

            <!-- SOBRE NÓS -->
            <LinearLayout
                android:id="@+id/btnSobreNos"
                style="@style/MenuItem">

                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_sobre_nos"
                    android:contentDescription="Sobre nós" />

                <TextView
                    style="@style/MenuText"
                    android:text="Sobre nós" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
